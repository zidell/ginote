          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 専用の試験的なアプリです。Web 版・デスクトップ版（Tauri）アプリと同じリポジトリをそのまま使います。"
          }
        },
        "zh-Hans" : {
