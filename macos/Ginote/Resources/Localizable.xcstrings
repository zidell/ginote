    "%@의 태그. ‘이름: 설명’ 형식으로 쓰면 설명이 음성 정제의 태그 분류에도 쓰입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags in %@. Im Format „Name: Beschreibung“ wird die Beschreibung auch bei der Sprachüberarbeitung zur Tag-Zuordnung genutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags in %@. Write them as “name: description” and the description is also used to classify tags during voice refinement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetas de %@. Con el formato «nombre: descripción», la descripción también se usa para clasificar etiquetas al refinar la voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags de %@. Au format « nom : description », la description sert aussi à classer les tags lors de l'affinage vocal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag di %@. Nel formato “nome: descrizione”, la descrizione viene usata anche per classificare i tag durante la rifinitura vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のタグ。「名前: 説明」の形式で書くと、説明は音声整形でのタグ分類にも使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中的标签。按“名称: 说明”格式填写时，说明也会用于语音润色时的标签分类。"
          }
        }
      }
    },
