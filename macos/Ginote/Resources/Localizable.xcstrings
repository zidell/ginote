    },
    "‘%@’에 쓰던 단축키라 그쪽은 비웠습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kurzbefehl gehörte zu „%@“; dort wurde er entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That shortcut was used by “%@”, so it was removed there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese atajo lo usaba «%@», así que se ha quitado de allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce raccourci était utilisé par « %@ » ; il y a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbreviazione era usata da “%@”, quindi è stata rimossa lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」で使っていたショートカットなので、そちらは空にしました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该快捷键原用于“%@”，已从那里移除。"
          }
        }
      }
    },
