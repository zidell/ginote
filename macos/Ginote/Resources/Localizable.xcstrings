    "⌘클릭·⇧클릭으로 선택을 바꿉니다. ⎋로 선택을 해제합니다. 아래는 마지막으로 누른 노트입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit ⌘-Klick oder ⇧-Klick änderst du die Auswahl, mit ⎋ hebst du sie auf. Unten siehst du die zuletzt angeklickte Notiz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-click or ⇧-click to change the selection. Press ⎋ to deselect. Below is the last note you clicked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic o ⇧-clic para cambiar la selección y ⎋ para quitarla. Abajo está la última nota en la que hiciste clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic ou ⇧-clic pour modifier la sélection, ⎋ pour la désélectionner. En dessous : la dernière note cliquée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic o ⇧-clic per cambiare la selezione, ⎋ per annullarla. Sotto c'è l'ultima nota cliccata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘クリック・⇧クリックで選択を変更し、⎋ で選択を解除します。下は最後にクリックしたノートです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘点按或 ⇧点按可更改选择，按 ⎋ 取消选择。下方是最后点按的笔记。"
          }
        }
      }
    },
