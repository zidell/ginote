    },
    "노트는 직접 만든 비공개 GitHub 저장소의 이슈로 저장됩니다. 태그는 라벨, 덧붙인 기록은 댓글, 휴지통은 닫힌 이슈입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen werden als Issues in einem privaten GitHub-Repository gespeichert, das du selbst erstellst. Tags sind Labels, Kommentare sind Issue-Kommentare, der Papierkorb sind geschlossene Issues."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes are stored as issues in a private GitHub repository you create. Tags are labels, comments are issue comments, and the trash is closed issues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas se guardan como issues en un repositorio privado de GitHub que creas tú. Las etiquetas son labels, los comentarios son comentarios de la issue y la papelera son las issues cerradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes sont stockées sous forme d'issues dans un dépôt GitHub privé que vous créez. Les tags sont des labels, les commentaires des commentaires d'issue et la corbeille les issues fermées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note vengono salvate come issue in un repository GitHub privato creato da te. I tag sono le etichette, i commenti sono i commenti delle issue e il cestino sono le issue chiuse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートは自分で作った非公開の GitHub リポジトリの Issue として保存されます。タグはラベル、コメントは Issue のコメント、ゴミ箱はクローズした Issue です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记以 Issue 的形式保存在你自己创建的私有 GitHub 存储库中。标签对应 Label，评论对应 Issue 评论，回收站对应已关闭的 Issue。"
          }
        }
      }
    },
    "노트당 첨부파일은 최대 %lld개까지 추가할 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Notiz sind höchstens %lld Anhänge möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each note can have up to %lld attachments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada nota puede tener hasta %lld adjuntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque note peut contenir jusqu'à %lld pièces jointes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni nota può avere al massimo %lld allegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルはノートごとに最大 %lld 件まで追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每篇笔记最多可添加 %lld 个附件。"
          }
        }
      }
    },
    "노트당 첨부파일은 최대 %lld개라서 %lld개만 추가했습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Notiz sind höchstens %1$lld Anhänge möglich, daher wurden nur %2$lld hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %2$lld attachments were added because each note can have up to %1$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada nota admite hasta %1$lld adjuntos, así que solo se añadieron %2$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note ne peut contenir que %1$lld pièces jointes : seules %2$lld ont été ajoutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni nota può avere al massimo %1$lld allegati, quindi ne sono stati aggiunti solo %2$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルはノートごとに最大 %1$lld 件のため、%2$lld 件だけ追加しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每篇笔记最多 %1$lld 个附件，因此只添加了 %2$lld 个。"
          }
        }
      }
    },
