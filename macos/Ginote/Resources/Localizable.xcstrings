    "#%@ 태그를 모든 노트에서 삭제할까요?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag #%@ aus allen Notizen löschen?"
          }
        },
        "en" : {
