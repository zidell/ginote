            "value" : "„%@“ wurde auf einem anderen Gerät in den Papierkorb gelegt. Wiederherstellen und deine Änderungen speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” was moved to the trash on another device. Restore it and save your changes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se movió a la papelera en otro dispositivo. ¿Restaurarla y guardar tus cambios?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été placée dans la corbeille sur un autre appareil. La restaurer et enregistrer vos modifications ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è stata spostata nel cestino su un altro dispositivo. Ripristinarla e salvare le modifiche?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は別のデバイスでゴミ箱に移動されました。復元して変更を保存しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
