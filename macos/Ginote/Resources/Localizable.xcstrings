    "macOS 전용 시험 앱입니다. 웹·데스크톱(Tauri) 앱과 같은 저장소를 그대로 씁니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine experimentelle App nur für macOS. Sie nutzt dieselben Repositorys wie die Web- und Desktop-App (Tauri)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An experimental macOS-only app. It uses the same repositories as the web and desktop (Tauri) apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app experimental solo para macOS. Usa los mismos repositorios que las apps web y de escritorio (Tauri)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app expérimentale réservée à macOS. Elle utilise les mêmes dépôts que les apps web et de bureau (Tauri)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
