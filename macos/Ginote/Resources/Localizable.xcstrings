    "고유명사·전문용어를 쉼표로 적으면 전사가 더 정확해집니다. 이 저장소를 쓰는 모든 기기가 같이 씁니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigennamen und Fachbegriffe durch Kommas getrennt eintragen, um die Transkription zu verbessern. Gilt für alle Geräte mit diesem Repository."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "List proper nouns and technical terms separated by commas to improve transcription. Shared by every device using this repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe nombres propios y términos técnicos separados por comas para mejorar la transcripción. Lo comparten todos los dispositivos que usan este repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez noms propres et termes techniques séparés par des virgules pour une transcription plus précise. Partagé par tous les appareils utilisant ce dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca nomi propri e termini tecnici separati da virgole per una trascrizione più accurata. Condiviso da tutti i dispositivi che usano questo repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固有名詞や専門用語をカンマ区切りで書くと、文字起こしがより正確になります。このリポジトリを使うすべてのデバイスで共有されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用逗号列出专有名词和术语，可让转写更准确。使用此存储库的所有设备共享这些词。"
          }
        }
      }
    },
