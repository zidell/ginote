    "%lld개 노트를 시간순 기록 하나로 병합할까요? 원본 노트는 휴지통으로 옮깁니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Notizen chronologisch zu einer Notiz zusammenführen? Die ursprünglichen Notizen werden in den Papierkorb verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge %lld notes into a single chronological note? The original notes will be moved to the trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Combinar %lld notas en una sola nota cronológica? Las notas originales se moverán a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionner %lld notes en une seule note chronologique ? Les notes d'origine seront placées dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unire %lld note in un'unica nota cronologica? Le note originali verranno spostate nel cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のノートを時系列の 1 つのノートに結合しますか？元のノートはゴミ箱に移動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将 %lld 篇笔记按时间顺序合并为一篇吗？原始笔记将移到回收站。"
          }
        }
      }
    },
