    "Fine-grained 개인 액세스 토큰(PAT)을 만드세요. Repository access는 이 저장소만, 권한은 Issues: Read and write(필수)와 Contents: Read and write(첨부파일)입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein Fine-grained Personal Access Token (PAT). Repository access nur für dieses Repository, Berechtigungen: Issues: Read and write (erforderlich) und Contents: Read and write (Anhänge)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a fine-grained personal access token (PAT). Set Repository access to this repository only, with Issues: Read and write (required) and Contents: Read and write (for attachments)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un token de acceso personal (PAT) fine-grained. Repository access solo para este repositorio, con permisos Issues: Read and write (obligatorio) y Contents: Read and write (adjuntos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un jeton d'accès personnel (PAT) fine-grained. Repository access : ce dépôt uniquement ; autorisations : Issues: Read and write (obligatoire) et Contents: Read and write (pièces jointes)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un token di accesso personale (PAT) fine-grained. Repository access solo per questo repository, con permessi Issues: Read and write (obbligatorio) e Contents: Read and write (allegati)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine-grained 個人アクセストークン（PAT）を作成してください。Repository access はこのリポジトリのみ、権限は Issues: Read and write（必須）と Contents: Read and write（添付ファイル）です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请创建 Fine-grained 个人访问令牌（PAT）。Repository access 只选此存储库，权限为 Issues: Read and write（必需）和 Contents: Read and write（附件）。"
          }
        }
      }
    },
