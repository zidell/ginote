    "마이크 권한이 없습니다. 시스템 설정 → 개인정보 보호 및 보안 → 마이크에서 Ginote Native를 허용하세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Mikrofonzugriff. Erlaube Ginote Native unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No microphone access. Allow Ginote Native in System Settings → Privacy & Security → Microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay acceso al micrófono. Permite Ginote Native en Ajustes del Sistema → Privacidad y seguridad → Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'accès au micro. Autorisez Ginote Native dans Réglages Système → Confidentialité et sécurité → Micro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun accesso al microfono. Consenti Ginote Native in Impostazioni di Sistema → Privacy e sicurezza → Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセス権がありません。システム設定 → プライバシーとセキュリティ → マイク で Ginote Native を許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有麦克风权限。请在“系统设置”→“隐私与安全性”→“麦克风”中允许 Ginote Native。"
          }
        }
      }
    },
