    "첨부 권한이 없습니다. PAT에 Contents: Read and write 권한을 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Berechtigung für Anhänge. Erteile dem PAT die Berechtigung Contents: Read and write."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No permission to attach files. Give the PAT Contents: Read and write access."
          }
        },
