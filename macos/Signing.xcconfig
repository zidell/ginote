// 코드 서명. 기본은 로컬 실행용 임시 서명(-)이다. 임시 서명은 빌드마다 앱 식별값이 바뀌어 키체인 "항상 허용"이
// 풀린다. 인증서가 있는 기기는 같은 폴더에 Signing.local.xcconfig(커밋하지 않음)를 두고 아래 두 값을 덮어쓴다.
//   CODE_SIGN_IDENTITY = Developer ID Application
//   DEVELOPMENT_TEAM = <팀 ID>
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual

#include? "Signing.local.xcconfig"
